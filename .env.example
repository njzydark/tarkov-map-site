# Garage / S3 API endpoint. Do not use the public website URL here.
S3_ENDPOINT=https://s3.example.com

# Destination bucket.
S3_BUCKET=tarkov-maps

# Garage accepts any consistent region value; "garage" is the project default.
S3_REGION=garage

# Optional path inside the bucket. Leave empty to upload to the bucket root.
S3_PREFIX=

# Garage S3 access credentials. Copy this file to .env and fill in real values.
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY

# Optional temporary-session credential; normally unused by Garage.
# AWS_SESSION_TOKEN=YOUR_SESSION_TOKEN

# Alternatively remove the key fields above and use a configured AWS profile.
# AWS_PROFILE=garage
